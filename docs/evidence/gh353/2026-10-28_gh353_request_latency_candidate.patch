+        with_messaging_mailbox(&[("CONTACT_ENFORCEMENT_ENABLED", "0")], |mailbox| {
+            use mcp_agent_mail_db::write_barrier::{
+                active_writer_count, current_thread_holds_promotion_barrier,
+                try_acquire_promotion_barrier_if_idle,
