+#[derive(Debug, PartialEq, Eq)]
+enum RetryBudgetSignal {
+    Prepared(usize),
+    FenceHeld(usize),
+    Deferred(usize),
+    Released(usize),
+}
+
+#[cfg(target_os = "linux")]
+fn arm_retry_budget_hooks(
+    round: usize,
+    commands: std::sync::mpsc::Sender<RetryBudgetSignal>,
+    responses: Arc<Mutex<std::sync::mpsc::Receiver<RetryBudgetSignal>>>,
+    project_root: PathBuf,
+    fallback_seen: Arc<AtomicBool>,
+    deferrals: Arc<AtomicUsize>,
+) {
+    let prepared_commands = commands.clone();
+    let prepared_responses = Arc::clone(&responses);
+    MESSAGE_PUBLICATION_AFTER_PREPARE_TEST_HOOK.with(|slot| {
+        *slot.borrow_mut() = Some(Box::new(move || {
+            prepared_commands
+                .send(RetryBudgetSignal::Prepared(round))
+                .unwrap();
+            assert_eq!(
+                prepared_responses
+                    .lock()
+                    .unwrap()
+                    .recv_timeout(Duration::from_secs(15))
+                    .unwrap(),
+                RetryBudgetSignal::FenceHeld(round)
+            );
+        }));
+    });
+    MESSAGE_PUBLICATION_AFTER_DEFER_TEST_HOOK.with(|slot| {
+        *slot.borrow_mut() = Some(Box::new(move || {
+            deferrals.fetch_add(1, Ordering::AcqRel);
+            commands.send(RetryBudgetSignal::Deferred(round)).unwrap();
+            assert_eq!(
+                responses
+                    .lock()
+                    .unwrap()
+                    .recv_timeout(Duration::from_secs(15))
+                    .unwrap(),
+                RetryBudgetSignal::Released(round)
+            );
+            if round < 3 {
+                arm_retry_budget_hooks(
+                    round + 1,
+                    commands,
+                    responses,
+                    project_root,
+                    fallback_seen,
+                    deferrals,
+                );
+            } else {
+                // The next proof must be newly prepared inside the final
+                // synchronized window, rather than raising the retry count
+                // or publishing an old prepared absence result.
+                MESSAGE_PUBLICATION_AFTER_PREPARE_TEST_HOOK.with(|next| {
+                    *next.borrow_mut() = Some(Box::new(move || {
+                        assert!(
+                            ARCHIVE_MUTATION_DEPTH.with(std::cell::Cell::get) > 0,
+                            "exhausted optimistic attempts require synchronized preparation"
+                        );
+                        assert!(active_project_lock_generation(&project_root).is_some());
+                        fallback_seen.store(true, Ordering::Release);
+                    }));
+                });
+            }
+        }));
+    });
+}
