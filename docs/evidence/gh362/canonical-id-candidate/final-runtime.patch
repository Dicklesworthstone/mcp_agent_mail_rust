+                append_message_bundle_files(&mailbox.archive, entry, &mut paths, Some(&ids))?;
+            enqueue_async_commit(
+                &mailbox.archive.repo_root,
+                &mailbox.config,
+                &meta.auto_commit_message,
+                &paths,
+            );
+            Ok(())
+        },
+    )
+}
