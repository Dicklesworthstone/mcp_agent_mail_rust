@@ -0,0 +1,640 @@
+//! Test-only paired public-writer benchmark for the unchanged incumbent.
+//! The worker and fixture helpers match the candidate verbatim. The enrollment
+//! observer returns None because this revision has no change-watch backend.
+
+use super::*;
+use std::process::{Command, Stdio};
+use tempfile::TempDir;
+
+const CHILD_CASE: &str = "AM_CANONICAL_ID_REGRESSION_CHILD";
+const SENDER: &str = "BlueLake";
+const RECIPIENT: &str = "GreenCastle";
+
+fn isolated_case(name: &str) -> bool {
+    isolated_case_inner(name, false)
+}
+
+fn isolated_case_inner(name: &str, ignored: bool) -> bool {
+    let selector = format!("canonical_id_tests::{name}");
+    if std::env::var(CHILD_CASE).ok().as_deref() == Some(selector.as_str()) {
+        return true;
+    }
+    let root = TempDir::new().unwrap();
+    let mut command = Command::new(std::env::current_exe().unwrap());
+    command
+        .args(["--exact", &selector, "--nocapture"])
+        .env(CHILD_CASE, &selector)
+        .env("STORAGE_ROOT", root.path())
+        .env("AM_COALESCER_MAX_WORKERS", "1");
+    if ignored {
+        command.arg("--ignored");
+    }
+    let output = command
+        .output()
+        .expect("run isolated canonical-ID regression");
+    assert!(
+        output.status.success(),
+        "{selector} failed:\n{}\n{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr),
+    );
+    assert!(
+        String::from_utf8_lossy(&output.stdout).contains("test result: ok. 1 passed"),
+        "the child selector must run exactly one test"
+    );
+    if ignored {
+        print!("{}", String::from_utf8_lossy(&output.stdout));
+    }
+    false
+}
+
+struct Mailbox {
+    _root: TempDir,
+    config: Config,
+    archive: ProjectArchive,
+}
+
+impl Mailbox {
+    fn new() -> Self {
+        let root = TempDir::new().unwrap();
+        let config = Config {
+            storage_root: root.path().to_path_buf(),
+            ..Config::default()
+        };
+        let archive = ensure_archive(&config, "canonical-history").unwrap();
+        Self {
+            _root: root,
+            config,
+            archive,
+        }
+    }
+
+    fn message(&self, id: i64, subject: &str) -> serde_json::Value {
+        fixture_message(&self.archive, id, subject)
+    }
+
+    fn publish(&self, message: &serde_json::Value) -> Result<()> {
+        write_message_bundle(
+            &self.archive,
+            &self.config,
+            message,
+            "immutable message body",
+            SENDER,
+            &[RECIPIENT.to_owned()],
+            &[],
+            None,
+        )
+    }
+
+    fn paths(&self, message: &serde_json::Value) -> MessageArchivePaths {
+        message_paths_for_bundle(&self.archive, message, SENDER, &[RECIPIENT.to_owned()])
+            .unwrap()
+            .0
+    }
+
+    fn seed_old_history(&self) -> PathBuf {
+        let month = self.archive.root.join("messages/2024/01");
+        fs::create_dir_all(&month).unwrap();
+        fs::create_dir_all(self.archive.root.join("messages/2026/10")).unwrap();
+        for id in 10..26 {
+            fs::write(
+                month.join(format!("historical__{id}.md")),
+                historical_content(id),
+            )
+            .unwrap();
+        }
+        self.publish(&self.message(80, "Warm the real publication cache"))
+            .unwrap();
+        flush_fixture_commits();
+        self.publish(&self.message(81, "Settle the initial publication"))
+            .unwrap();
+        flush_fixture_commits();
+        month.join("historical__10.md")
+    }
+
+    fn assert_unpublished(&self, message: &serde_json::Value) {
+        let paths = self.paths(message);
+        for path in [&paths.canonical, &paths.outbox]
+            .into_iter()
+            .chain(&paths.inbox)
+        {
+            assert!(!path.exists(), "refused message created {}", path.display());
+        }
+    }
+}
+
+fn fixture_message(archive: &ProjectArchive, id: i64, subject: &str) -> serde_json::Value {
+    serde_json::json!({
+        "id": id,
+        "from": SENDER,
+        "to": [RECIPIENT],
+        "cc": [],
+        "bcc": [],
+        "subject": subject,
+        "created": "2026-10-31T12:00:00Z",
+        "project": archive.slug,
+    })
+}
+
+fn historical_content(id: i64) -> String {
+    render_message_bundle_content(&serde_json::json!({ "id": id }), "historical evidence").unwrap()
+}
+
+fn assert_collision(error: &StorageError, id: i64) {
+    assert!(
+        error
+            .to_string()
+            .contains(&format!("canonical message id {id} already exists")),
+        "expected duplicate canonical identity refusal, got {error}"
+    );
+}
+
+fn assert_fixture_coalescer_idle() {
+    let Some(coalescer) = COMMIT_COALESCER.get() else {
+        return;
+    };
+    // flush_async_commits() has a timeout and returns no Result. A timed-out
+    // queue must not be mistaken for a settled fixture or contaminate the next
+    // sample with previous Git work.
+    assert_eq!(
+        coalescer.pending_requests(),
+        0,
+        "fixture commit flush left pending archive requests"
+    );
+    // This cumulative count includes failed commit groups/spills even if a
+    // later coalescer retry succeeds. An empty queue must not hide that error.
+    assert_eq!(
+        coalescer.stats().errors,
+        0,
+        "fixture commit group or spill failed, including recovered coalescer retries"
+    );
+    let repos = coalescer
+        .repos
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    assert!(
+        repos.values().all(|queue| {
+            queue.depth.load(Ordering::Relaxed) == 0 && !queue.processing.load(Ordering::Relaxed)
+        }),
+        "fixture commit flush returned while a repository was still active"
+    );
+}
+
+fn flush_fixture_commits() {
+    flush_async_commits();
+    assert_fixture_coalescer_idle();
+}
+
+#[test]
+fn historical_in_place_rewrite_is_detected_before_the_next_publication() {
+    if !isolated_case("historical_in_place_rewrite_is_detected_before_the_next_publication") {
+        return;
+    }
+    for batch in [false, true] {
+        let mailbox = Mailbox::new();
+        let historical = mailbox.seed_old_history();
+        let parent = historical.parent().unwrap();
+        let parent_before = current_path_stamp(parent);
+        let root_before = current_path_stamp(&mailbox.archive.root.join("messages"));
+        let before = fs::metadata(&historical).unwrap();
+        let retained = historical_content(90);
+        assert_eq!(retained.len() as u64, before.len());
+        fs::write(&historical, &retained).unwrap();
+        fs::File::options()
+            .write(true)
+            .open(&historical)
+            .unwrap()
+            .set_times(fs::FileTimes::new().set_modified(before.modified().unwrap()))
+            .unwrap();
+        assert_eq!(current_path_stamp(parent), parent_before);
+        assert_eq!(
+            current_path_stamp(&mailbox.archive.root.join("messages")),
+            root_before
+        );
+
+        let message = mailbox.message(90, "Must notice an old rewritten identity");
+        let result = if batch {
+            write_message_batch_bundle(
+                &mailbox.archive,
+                &mailbox.config,
+                &[MessageBundleBatchEntry {
+                    message: &message,
+                    body_md: "immutable message body",
+                    sender: SENDER,
+                    recipients: &[RECIPIENT.to_owned()],
+                    extra_paths: &[],
+                }],
+                None,
+            )
+        } else {
+            mailbox.publish(&message)
+        };
+        assert_collision(&result.expect_err("old in-place rewrite was missed"), 90);
+        assert_eq!(fs::read_to_string(&historical).unwrap(), retained);
+        mailbox.assert_unpublished(&message);
+    }
+}
+
+/// Run Git against only the temporary fixture, regardless of enclosing Git
+/// environment variables.
+fn fixture_git(mailbox: &Mailbox) -> Command {
+    let mut command = Command::new("git");
+    command
+        .arg("-C")
+        .arg(&mailbox.archive.repo_root)
+        .arg("--git-dir")
+        .arg(mailbox.archive.repo_root.join(".git"))
+        .arg("--work-tree")
+        .arg(&mailbox.archive.repo_root);
+    // A developer's enclosing Git command must not redirect fixture writes to
+    // their repository, index, object database, or quarantine directory.
+    for variable in [
+        "GIT_DIR",
+        "GIT_COMMON_DIR",
+        "GIT_WORK_TREE",
+        "GIT_INDEX_FILE",
+        "GIT_OBJECT_DIRECTORY",
+        "GIT_ALTERNATE_OBJECT_DIRECTORIES",
+        "GIT_QUARANTINE_PATH",
+        "GIT_NAMESPACE",
+    ] {
+        command.env_remove(variable);
+    }
+    command
+}
+
+/// Build the three-copy archive layout and a Git commit/index before measuring.
+/// Historical mailbox copies are hard-linked to their canonical file to bound
+/// fixture disk use; each canonical message has a distinct inode. Measured new
+/// messages use the real writer and create independent durable copies. No
+/// seeding, aging, cold initialization, or Git setup is charged to the samples.
+fn seed_scale_mailbox(mailbox: &Mailbox, count: usize) {
+    let body = "A real archived coordination message with enough text to exercise JSON and Markdown reads.\n".repeat(8);
+    let (branch, parent) = {
+        let repo = Repository::open(&mailbox.archive.repo_root).unwrap();
+        let head = repo.head().unwrap();
+        assert!(
+            head.is_branch(),
+            "fixture HEAD must name its initialized branch"
+        );
+        (
+            head.name().unwrap().to_owned(),
+            head.peel_to_commit().unwrap().id(),
+        )
+    };
+    // Stream blobs directly into a pack instead of creating one loose object
+    // per historical message. The worktree and committed 3*count paths are the
+    // same as an add_all/write_tree seed; only unmeasured fixture setup differs.
+    let mut importer = fixture_git(mailbox)
+        .args(["fast-import", "--quiet"])
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("start Git fast-import for packed benchmark history");
+    let mut stream = std::io::BufWriter::new(importer.stdin.take().unwrap());
+    stream.write_all(b"feature done\n").unwrap();
+    for month in 1..=12 {
+        for base in [
+            mailbox.archive.root.join("messages"),
+            mailbox.archive.root.join(format!("agents/{SENDER}/outbox")),
+            mailbox
+                .archive
+                .root
+                .join(format!("agents/{RECIPIENT}/inbox")),
+        ] {
+            fs::create_dir_all(base.join(format!("2025/{month:02}"))).unwrap();
+            fs::create_dir_all(base.join("2026/10")).unwrap();
+        }
+    }
+    for id in 1..=count {
+        let month = (id - 1) % 12 + 1;
+        let filename = format!("2025-{month:02}-01T00-00-00Z__history__{id}.md");
+        let mut message = mailbox.message(i64::try_from(id).unwrap(), "Archived history");
+        message["created"] = format!("2025-{month:02}-01T00:00:00Z").into();
+        let content = render_message_bundle_content(&message, &body).unwrap();
+        writeln!(stream, "blob\nmark :{id}\ndata {}", content.len()).unwrap();
+        stream.write_all(content.as_bytes()).unwrap();
+        stream.write_all(b"\n").unwrap();
+        let canonical = mailbox
+            .archive
+            .root
+            .join(format!("messages/2025/{month:02}"))
+            .join(&filename);
+        fs::write(&canonical, &content).unwrap();
+        for base in [
+            mailbox.archive.root.join(format!("agents/{SENDER}/outbox")),
+            mailbox
+                .archive
+                .root
+                .join(format!("agents/{RECIPIENT}/inbox")),
+        ] {
+            fs::hard_link(
+                &canonical,
+                base.join(format!("2025/{month:02}")).join(&filename),
+            )
+            .unwrap();
+        }
+    }
+    let timestamp = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_secs();
+    let commit_message = b"Seed canonical publication benchmark history\n";
+    writeln!(stream, "commit {branch}").unwrap();
+    writeln!(
+        stream,
+        "committer Canonical archive benchmark <bench@localhost> {timestamp} +0000"
+    )
+    .unwrap();
+    writeln!(stream, "data {}", commit_message.len()).unwrap();
+    stream.write_all(commit_message).unwrap();
+    writeln!(stream, "\nfrom {parent}").unwrap();
+    for id in 1..=count {
+        let month = (id - 1) % 12 + 1;
+        let filename = format!("2025-{month:02}-01T00-00-00Z__history__{id}.md");
+        for base in [
+            "messages".to_owned(),
+            format!("agents/{SENDER}/outbox"),
+            format!("agents/{RECIPIENT}/inbox"),
+        ] {
+            writeln!(
+                stream,
+                "M 100644 :{id} projects/{}/{base}/2025/{month:02}/{filename}",
+                mailbox.archive.slug,
+            )
+            .unwrap();
+        }
+    }
+    stream.write_all(b"\ndone\n").unwrap();
+    stream.flush().unwrap();
+    drop(stream);
+    let imported = importer.wait_with_output().unwrap();
+    assert!(
+        imported.status.success(),
+        "Git fast-import failed: {}",
+        String::from_utf8_lossy(&imported.stderr)
+    );
+    // Populate the real on-disk Git index without changing the fixture files.
+    // Preserve the initialized parent tree, including archive attributes.
+    let indexed = fixture_git(mailbox)
+        .args(["read-tree", "HEAD"])
+        .output()
+        .expect("populate benchmark Git index from its seeded commit");
+    assert!(
+        indexed.status.success(),
+        "Git read-tree failed: {}",
+        String::from_utf8_lossy(&indexed.stderr)
+    );
+    let repo = Repository::open(&mailbox.archive.repo_root).unwrap();
+    let index = repo.index().unwrap();
+    assert!(index.len() >= count * 3, "all three copies must be tracked");
+    let seeded_commit = repo.head().unwrap().peel_to_commit().unwrap();
+    assert_eq!(seeded_commit.parent_id(0).unwrap(), parent);
+    assert!(
+        seeded_commit
+            .tree()
+            .unwrap()
+            .get_path(Path::new(".gitattributes"))
+            .is_ok()
+    );
+    // A freshly created file is intentionally uncacheable inside the Git-style
+    // racy timestamp window. Age the fixture, not the cache's trusted stamps.
+    std::thread::sleep(RACY_STAMP_WINDOW + Duration::from_millis(20));
+}
