+#[test]
+fn deferred_proof_detects_a_foreign_process_rewriting_old_history() {
+    if !isolated_case("deferred_proof_detects_a_foreign_process_rewriting_old_history") {
+        return;
+    }
+    let mailbox = Mailbox::new();
+    let historical = mailbox.seed_old_history();
+    let message = mailbox.message(90, "Foreign writer invalidates a prepared absence proof");
+    let root_before = current_path_stamp(&mailbox.archive.root.join("messages"));
+    let (deferred_tx, deferred_rx) = std::sync::mpsc::channel();
+    let (resume_tx, resume_rx) = std::sync::mpsc::channel();
+    let fence = ArchiveMutationGuard::begin_at(&mailbox.archive.repo_root);
+    let archive = mailbox.archive.clone();
+    let config = mailbox.config.clone();
+    let outgoing = message.clone();
+    let writer = std::thread::spawn(move || {
+        MESSAGE_PUBLICATION_AFTER_DEFER_TEST_HOOK.with(|slot| {
+            *slot.borrow_mut() = Some(Box::new(move || {
+                deferred_tx.send(()).unwrap();
+                resume_rx.recv_timeout(Duration::from_secs(15)).unwrap();
+            }));
+        });
+        write_message_bundle(
+            &archive,
+            &config,
+            &outgoing,
+            "immutable message body",
+            SENDER,
+            &[RECIPIENT.to_owned()],
+            &[],
+            None,
+        )
+    });
+    let deferred = deferred_rx.recv_timeout(Duration::from_secs(10));
+    if deferred.is_ok() {
+        run_worker(&mailbox, "rewrite", &historical);
+    }
+    drop(fence);
+    let _ = resume_tx.send(());
+    let result = writer.join().unwrap();
+    assert!(
+        deferred.is_ok(),
+        "read-only preparation waited for the global fence"
+    );
+    assert_eq!(
+        current_path_stamp(&mailbox.archive.root.join("messages")),
+        root_before
+    );
+    assert_collision(&result.expect_err("stale deferred proof was accepted"), 90);
+    mailbox.assert_unpublished(&message);
+    assert_eq!(
+        fs::read_to_string(&historical).unwrap(),
+        historical_content(90)
+    );
+}
