+fn run_worker(mailbox: &Mailbox, action: &str, path: &Path) {
+    let output = Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--exact",
+            "canonical_id_tests::canonical_id_external_process_worker",
+            "--nocapture",
+        ])
+        .env(WORKER_ACTION, action)
+        .env("AM_CANONICAL_ID_WORKER_ROOT", &mailbox.config.storage_root)
+        .env("AM_CANONICAL_ID_WORKER_PROJECT", &mailbox.archive.root)
+        .env("AM_CANONICAL_ID_WORKER_PATH", path)
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "external worker {action} failed:\n{}\n{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(
+        String::from_utf8_lossy(&output.stdout).contains("test result: ok. 1 passed"),
+        "external worker selector must run exactly one test"
+    );
+}
