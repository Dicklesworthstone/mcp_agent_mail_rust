+    let (deferred_tx, deferred_rx) = std::sync::mpsc::channel();
+    let (resume_tx, resume_rx) = std::sync::mpsc::channel();
+    let fence = ArchiveMutationGuard::begin_at(&mailbox.archive.repo_root);
+    let writer = std::thread::spawn(move || {
