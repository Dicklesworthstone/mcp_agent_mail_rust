+    #[test]
+    fn normalization_repairs_real_export_before_strict_backup_validation() {
+        let (path, conn) = fixture("idx_agents_project_name_nocase", &["Z", "["], "BINARY", "NOCASE", false);
+        let before_rows = agent_rows(&conn);
+        assert!(!integrity::details_indicate_ok(&full(&conn)));
+        assert!(integrity::details_indicate_ok(
+            &proactive_backup_export_check_details(&conn, integrity::CheckKind::Quick).unwrap()
+        ));
+        for sql in [
+            "SELECT count(*) AS n FROM agents NOT INDEXED",
+            "SELECT count(*) AS n FROM agents INDEXED BY idx_agents_project_name_nocase WHERE 1",
+        ] {
+            assert_eq!(conn.query_sync(sql, &[]).unwrap()[0].get_named::<i64>("n").unwrap(), 2);
+        }
+        let unrepaired = path.with_file_name("unrepaired.sqlite3");
+        conn.backup_to_path(unrepaired.to_str().unwrap()).unwrap();
+        assert!(!sqlite_recovery_candidate_passes_full_integrity_check(&unrepaired).unwrap());
+        assert_eq!(normalize_proactive_backup_export(&conn).unwrap(), 1);
+        assert_eq!(agent_rows(&conn), before_rows);
+        assert!(integrity::details_indicate_ok(&full(&conn)));
+        let snapshot = path.with_file_name("snapshot.sqlite3");
+        conn.backup_to_path(snapshot.to_str().unwrap()).unwrap();
+        drop(conn);
+        assert!(sqlite_recovery_candidate_passes_full_integrity_check(&snapshot).unwrap());
+        let reopened = open_immutable_canonical_sqlite(&snapshot).unwrap();
+        assert_eq!(agent_rows(&reopened), before_rows);
+    }
