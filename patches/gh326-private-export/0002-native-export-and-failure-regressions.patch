+    #[test]
+    fn real_staging_retains_a_duplicate_key_export_without_touching_prior_backup() {
+        let (source, conn) = fixture("idx_duplicate", &["A", "a"], "BINARY", "BINARY", false);
+        drop(conn);
+        let before = std::fs::read(&source).unwrap();
+        let backup = source.with_file_name("published.bak");
+        std::fs::write(&backup, b"previous published generation").unwrap();
+        let error = expect_stage_failure(create_proactive_backup_stage_with(
+            &source, &backup, |export| {
+                let private = crate::CanonicalDbConn::open_file(export.to_str().unwrap())
+                    .map_err(|error| DbError::Sqlite(error.to_string()))?;
+                private.execute_raw(
+                    "PRAGMA writable_schema=ON; \
+                     UPDATE sqlite_master SET sql=replace(sql, 'COLLATE BINARY', 'COLLATE NOCASE') \
+                         WHERE name='idx_duplicate'; \
+                     PRAGMA writable_schema=OFF; PRAGMA schema_version=203;"
+                ).map_err(|error| DbError::Sqlite(error.to_string()))
+            },
+        ));
+        assert!(error.to_string().contains("UNIQUE constraint failed"), "{error}");
+        let stage = retained_failed_stage(&source, &error);
+        assert!(!stage.join("snapshot.sqlite3").exists());
+        let retained = crate::CanonicalDbConn::open_file(stage.join("live-export.sqlite3").to_str().unwrap()).unwrap();
+        assert_eq!(agent_rows(&retained), vec![
+            (1, 1, Some("A".to_string())), (2, 1, Some("a".to_string())),
+        ]);
+        assert!(!integrity::details_indicate_ok(&full(&retained)));
+        assert_eq!(std::fs::read(source).unwrap(), before);
+        assert_eq!(std::fs::read(backup).unwrap(), b"previous published generation");
+    }
