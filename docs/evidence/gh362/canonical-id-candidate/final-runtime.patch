+            .publish(&outgoing)
+            .expect_err("a changed identity proof must not authorize publication");
+        if let StorageError::LockContention { message } = &error {
+            assert!(
+                message.contains("canonical"),
+                "unrelated contention: {error}"
+            );
+        } else {
+            assert_collision(&error, 90);
+        }
+        mailbox.assert_unpublished(&outgoing);
+        assert_eq!(
+            fs::read_to_string(historical).unwrap(),
+            historical_content(90)
+        );
+    }
+}
