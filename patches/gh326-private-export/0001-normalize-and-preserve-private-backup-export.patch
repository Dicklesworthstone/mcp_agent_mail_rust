+/// Rebuild only canonical NOCASE indexes named by an export-order disagreement.
+///
+/// GH#326: the runtime's VACUUM INTO can emit NOCASE keys in an order that
+/// canonical SQLite rejects. Its online-backup API copies those index pages;
+/// it does not rebuild them. This helper is ONLY for the process-exclusive
+/// intermediate export, before backup publication or health-witness capture.
+/// Never call it on a live mailbox, published backup, or recovery authority.
+///
+/// A passing export is not rewritten. Otherwise every diagnostic must name
+/// a real NOCASE index and be an exact lookup/uniqueness complaint; structural
+/// damage, entry-count loss, unavailable evidence, and other collations fail
+/// closed. REINDEX enforces actual uniqueness, and a strict full check must
+/// pass before the transaction is committed. None of these private-copy probes
+/// update the process-wide live-mailbox integrity metrics or circuit breaker.
+fn normalize_proactive_backup_export(conn: &crate::CanonicalDbConn) -> DbResult<usize> {
+    // This fresh private-export connection must not already be in a caller
+    // transaction. BEGIN failing leaves any such transaction owned by its
+    // caller; a successful BEGIN makes the entire rebuild ours to roll back.
+    conn.execute_raw("BEGIN IMMEDIATE")
+        .map_err(|error| DbError::Sqlite(format!("private export verification start: {error}")))?;
+    let result = (|| {
+        let full = proactive_backup_export_check_details(conn, integrity::CheckKind::Full)?;
+        if integrity::details_indicate_ok(&full) {
+            return Ok(0);
+        }
+        let quick = proactive_backup_export_check_details(conn, integrity::CheckKind::Quick)?;
+        if !integrity::details_indicate_ok(&quick) {
+            return Err(DbError::Sqlite(format!(
+                "private export failed structural verification; refusing NOCASE normalization: {}",
+                integrity::summarize_check_details(&quick)
+            )));
+        }
+        let targets = proactive_backup_export_nocase_targets(conn, &full)?;
+        for index in &targets {
+            // Schema qualification avoids REINDEX's collation-name precedence.
+            // The entire catalog-confirmed identifier is quoted, never a token
+            // extracted into executable SQL from an arbitrary error substring.
+            let quoted = index.replace('"', "\"\"");
+            conn.execute_raw(&format!("REINDEX main.\"{quoted}\""))
+                .map_err(|error| {
+                    DbError::Sqlite(format!(
+                        "private export NOCASE rebuild failed for {index}: {error}"
+                    ))
+                })?;
+        }
+        let verified = proactive_backup_export_check_details(conn, integrity::CheckKind::Full)?;
+        if !integrity::details_indicate_ok(&verified) {
+            return Err(DbError::Sqlite(format!(
+                "private export remained invalid after NOCASE normalization: {}",
+                integrity::summarize_check_details(&verified)
+            )));
+        }
+        Ok(targets.len())
+    })();
+    match result {
+        Ok(rebuilt) => {
+            match conn.execute_raw("COMMIT") {
+                Ok(()) => Ok(rebuilt),
+                Err(error) => {
+                    let rollback = conn.execute_raw("ROLLBACK");
+                    Err(DbError::Sqlite(format!(
+                        "private export normalization commit failed: {error}; rollback={rollback:?}"
+                    )))
+                }
+            }
+        }
+        Err(error) => {
+            // A later index can fail UNIQUE enforcement after an earlier one
+            // rebuilt successfully. Roll back the WHOLE normalization, not
+            // just the last REINDEX. Preserve a rollback failure as well.
+            match conn.execute_raw("ROLLBACK") {
+                Ok(()) => Err(error),
+                Err(rollback) => Err(DbError::Sqlite(format!(
+                    "{error}; private export normalization rollback failed: {rollback}"
+                ))),
+            }
+        }
+    }
+}
+
+fn proactive_backup_export_check_details(
+    conn: &crate::CanonicalDbConn,
+    kind: integrity::CheckKind,
+) -> DbResult<Vec<String>> {
+    let rows = integrity::probe_check_rows(
+        |sql| conn.query_sync(sql, &[]).map_err(|error| error.to_string()),
+        kind,
+    )
+    .map_err(|error| DbError::Sqlite(format!("private export {kind} unavailable: {error}")))?;
+    Ok(integrity::extract_check_details(&rows, kind))
+}
+
+/// Exact canonical diagnostics only. In particular, an entry-count mismatch
+/// is not a collation-ordering disagreement and cannot authorize this repair.
+fn proactive_backup_export_index_complaint(detail: &str) -> Option<&str> {
+    let detail = detail.trim();
+    let name = if let Some(name) = detail.strip_prefix("non-unique entry in index ") {
+        name
+    } else {
+        let (row, name) = detail.strip_prefix("row ")?.split_once(" missing from index ")?;
+        if row.is_empty() || !row.bytes().all(|byte| byte.is_ascii_digit()) {
+            return None;
+        }
+        name
+    };
+    (!name.is_empty() && !name.chars().any(char::is_control)).then_some(name)
+}
+
+fn proactive_backup_export_nocase_targets(
+    conn: &crate::CanonicalDbConn,
+    details: &[String],
+) -> DbResult<Vec<String>> {
+    let mut targets = std::collections::BTreeSet::new();
+    for detail in details {
+        if detail.trim() == "*** in database main ***" {
+            continue;
+        }
+        let index = proactive_backup_export_index_complaint(detail).ok_or_else(|| {
+            DbError::Sqlite(format!(
+                "private export has damage outside the NOCASE ordering class: {}",
+                integrity::summarize_check_details(details)
+            ))
+        })?;
+        if !targets.insert(index.to_string()) {
+            continue;
+        }
+        let catalog = conn
+            .query_sync(
+                "SELECT name FROM main.sqlite_master WHERE type = 'index' AND name = ?",
+                &[Value::Text(index.to_string())],
+            )
+            .map_err(|error| DbError::Sqlite(format!("private export index lookup: {error}")))?;
+        if catalog.len() != 1
+            || catalog[0].get_named::<String>("name").ok().as_deref() != Some(index)
+        {
+            return Err(DbError::Sqlite(format!(
+                "private export complaint does not identify one catalog index: {index}"
+            )));
+        }
+        let quoted = index.replace('"', "\"\"");
+        let columns = conn
+            .query_sync(&format!("PRAGMA main.index_xinfo(\"{quoted}\")"), &[])
+            .map_err(|error| DbError::Sqlite(format!("private export index metadata: {error}")))?;
+        let mut has_nocase_key = false;
+        for column in &columns {
+            let key = column.get_named::<i64>("key").map_err(|error| {
+                DbError::Sqlite(format!("private export index key metadata: {error}"))
+            })?;
+            match key {
+                0 => {}
+                1 => {
+                    let collation = column.get_named::<String>("coll").map_err(|error| {
+                        DbError::Sqlite(format!("private export index collation: {error}"))
+                    })?;
+                    if collation.eq_ignore_ascii_case("NOCASE") {
+                        has_nocase_key = true;
+                    } else if !collation.eq_ignore_ascii_case("BINARY") {
+                        // REINDEX rebuilds the whole composite index. One
+                        // NOCASE column must not authorize repairing a separate
+                        // RTRIM/custom-collation defect in another key column.
+                        return Err(DbError::Sqlite(format!(
+                            "private export index {index} has unsupported key collation \
+                             {collation}; refusing NOCASE-only normalization"
+                        )));
+                    }
+                }
+                _ => {
+                    return Err(DbError::Sqlite(format!(
+                        "private export index {index} has invalid key metadata: {key}"
+                    )));
+                }
+            }
+        }
+        if !has_nocase_key {
+            return Err(DbError::Sqlite(format!(
+                "private export complaint names an index without a NOCASE key: {index}"
+            )));
+        }
+    }
+    if targets.is_empty() {
+        return Err(DbError::Sqlite(
+            "private export has no actionable NOCASE index evidence".to_string(),
+        ));
+    }
+    Ok(targets.into_iter().collect())
+}
