+        const XFS_MAGIC: FsType = FsType(0x5846_5342);
+        matches!(
+            kind,
+            EXT4_SUPER_MAGIC // ext2/ext3/ext4 share the same type
+                | BTRFS_SUPER_MAGIC
+                | TMPFS_MAGIC
+                | F2FS_SUPER_MAGIC
+                | XFS_MAGIC
+                | OVERLAYFS_SUPER_MAGIC // through its mounted namespace
+        )
+    }
