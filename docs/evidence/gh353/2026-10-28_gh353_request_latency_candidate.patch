+        async fn send_probe(ctx: &McpContext, project: &str) -> McpResult<String> {
+            send_message(
+                ctx,
+                project.to_string(),
+                "BlueLake".to_string(),
+                vec!["GreenStone".to_string()],
+                "promotion admission probe".to_string(),
+                "persist only after admission".to_string(),
+                None,
+                None,
+                None,
+                None,
+                None,
+                None,
