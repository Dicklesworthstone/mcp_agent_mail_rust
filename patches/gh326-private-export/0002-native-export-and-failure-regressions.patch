+    #[test]
+    fn real_staging_retains_a_healthy_export_when_backup_copy_cannot_open_its_target() {
+        let (source, conn) = fixture("idx_healthy", &["Z", "["], "NOCASE", "NOCASE", false);
+        drop(conn);
+        let before = std::fs::read(&source).unwrap();
+        let backup = source.with_file_name("published.bak");
+        std::fs::write(&backup, b"previous published generation").unwrap();
+        let error = expect_stage_failure(create_proactive_backup_stage_with(
+            &source, &backup, |export| {
+                // A real OS/SQLite open failure, not a substituted error result.
+                std::fs::create_dir(export.with_file_name("snapshot.sqlite3"))
+                    .map_err(|error| DbError::Sqlite(error.to_string()))
+            },
+        ));
+        assert!(error.to_string().contains("failed to materialize a standalone snapshot"), "{error}");
+        let stage = retained_failed_stage(&source, &error);
+        assert!(stage.join("snapshot.sqlite3").is_dir());
+        let retained = crate::CanonicalDbConn::open_file(stage.join("live-export.sqlite3").to_str().unwrap()).unwrap();
+        assert!(integrity::details_indicate_ok(&full(&retained)));
+        assert_eq!(agent_rows(&retained).len(), 2);
+        assert_eq!(std::fs::read(source).unwrap(), before);
+        assert_eq!(std::fs::read(backup).unwrap(), b"previous published generation");
+    }
