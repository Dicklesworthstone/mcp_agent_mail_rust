+            }
+            let mut mask = AddWatchFlags::IN_MODIFY
+                | AddWatchFlags::IN_ATTRIB
+                | AddWatchFlags::IN_CLOSE_WRITE
+                | AddWatchFlags::IN_DELETE_SELF
+                | AddWatchFlags::IN_MOVE_SELF
+                | AddWatchFlags::IN_DONT_FOLLOW;
+            if directory.is_some() {
+                mask |= AddWatchFlags::IN_CREATE
+                    | AddWatchFlags::IN_DELETE
+                    | AddWatchFlags::IN_MOVED_FROM
+                    | AddWatchFlags::IN_MOVED_TO
+                    | AddWatchFlags::IN_ONLYDIR;
+            }
+            let Ok(descriptor) = self.notify.add_watch(path, mask) else {
+                return false;
+            };
+            let target = Target {
+                path: Arc::from(path),
+                directory,
+                inode: metadata.ino(),
+            };
+            // Do not repurpose a descriptor with queued events from its old
+            // inode, or merge two path spellings of one watched inode. A fresh
+            // instance is the only safe way to recover that correspondence.
+            if self
+                .targets
+                .get(&descriptor)
+                .is_some_and(|previous| previous != &target)
+                || self
+                    .paths
+                    .get(path)
+                    .is_some_and(|previous| *previous != descriptor)
+            {
+                return false;
+            }
+            self.paths.insert(Arc::clone(&target.path), descriptor);
+            self.targets.insert(descriptor, target);
+            true
+        }
+
+        pub(super) fn drain(&mut self) -> Option<BTreeSet<PathBuf>> {
+            if self.invalidated {
+                return None;
+            }
+            let mut paths = BTreeSet::new();
+            let mut count = 0_usize;
+            loop {
+                match self.notify.read_events() {
+                    Ok(events) if !events.is_empty() => {
+                        count = count.saturating_add(events.len());
+                        if count > MAX_EVENTS_PER_DRAIN {
+                            self.invalidated = true;
+                            return None;
+                        }
+                        for event in events {
+                            if !self.apply(event, &mut paths) {
+                                self.invalidated = true;
+                                return None;
+                            }
+                        }
+                    }
+                    Err(Errno::EAGAIN) => return Some(paths),
+                    Err(Errno::EINTR) => {
+                        // An interrupted read need not make progress. Count it
+                        // too so a signal storm cannot defeat the drain bound.
+                        count = count.saturating_add(1);
+                        if count > MAX_EVENTS_PER_DRAIN {
+                            self.invalidated = true;
+                            return None;
+                        }
+                    }
+                    // A zero-length read is not the EAGAIN exhaustion witness.
+                    Ok(_) | Err(_) => {
+                        self.invalidated = true;
+                        return None;
+                    }
+                }
+            }
+        }
+
+        fn apply(&self, event: InotifyEvent, paths: &mut BTreeSet<PathBuf>) -> bool {
+            if event.mask.intersects(
+                AddWatchFlags::IN_Q_OVERFLOW
+                    | AddWatchFlags::IN_IGNORED
+                    | AddWatchFlags::IN_UNMOUNT
+                    | AddWatchFlags::IN_MOVE_SELF
+                    | AddWatchFlags::IN_DELETE_SELF,
+            ) {
+                return false;
+            }
+            let Some(target) = self.targets.get(&event.wd) else {
+                return false;
+            };
+            let Some(directory) = target.directory else {
+                if event.name.is_some() || event.mask.contains(AddWatchFlags::IN_ISDIR) {
+                    return false;
+                }
+                paths.insert(target.path.to_path_buf());
+                return true;
+            };
+            let Some(name) = event.name else {
+                // Directory metadata changed (permissions, ownership, etc.).
+                // It may no longer be safe to traverse using the old evidence.
+                return false;
+            };
+            match directory {
+                WatchDirectory::Project => name != "messages",
+                WatchDirectory::Messages | WatchDirectory::Year => {
+                    let digits = if directory == WatchDirectory::Messages {
+                        4
+                    } else {
+                        2
+                    };
+                    !name.to_str().is_some_and(|name| {
+                        name.len() == digits && name.bytes().all(|byte| byte.is_ascii_digit())
+                    })
+                }
+                WatchDirectory::Month => {
+                    let path = target.path.join(name);
+                    if path.extension().is_some_and(|extension| extension == "md") {
+                        if event.mask.contains(AddWatchFlags::IN_ISDIR) {
+                            return false;
+                        }
+                        paths.insert(path);
+                    }
+                    true
+                }
+            }
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+        use crate::canonical_watch::CanonicalWatch;
