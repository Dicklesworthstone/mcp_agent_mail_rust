+        let historical = mailbox.seed_old_history();
+        assert!(
+            canonical_id_cache_for(&mailbox.archive.root.join("messages"))
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .watch
+                .is_some(),
+            "the notification-specific race test requires supported local storage"
+        );
+        let outgoing = mailbox.message(90, "Revalidate before installing immutable copies");
+        let injected_path = historical.clone();
+        let hook: Box<dyn FnOnce()> = Box::new(move || {
+            fs::write(injected_path, historical_content(90)).unwrap();
+        });
+        if after_staging {
+            MESSAGE_PUBLICATION_BEFORE_PERSIST_TEST_HOOK.with(|slot| {
+                *slot.borrow_mut() = Some(hook);
+            });
+        } else {
+            MESSAGE_PUBLICATION_AFTER_PREPARE_TEST_HOOK.with(|slot| {
