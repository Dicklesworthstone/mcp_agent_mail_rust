+    /// nopub experiment (C3): a commit is visible to a fresh FrankenSQLite
+    /// connection and to a canonical SQLite reader through the shared
+    /// WAL-index, with no checkpoint backfilling it into the main file; an
+    /// uncommitted write on another connection is visible to neither.
+    #[test]
+    fn commits_are_visible_to_fresh_and_canonical_readers_without_a_checkpoint() {
+        const COMMITTED: &str = "/workspace/visible-without-checkpoint";
+        const UNCOMMITTED: &str = "/workspace/never-committed";
+        let dir = tempfile::tempdir().expect("tempdir");
+        let db_path = dir.path().join("visibility.db");
+        let pool = crate::create_pool(&crate::pool::DbPoolConfig {
+            database_url: format!("sqlite:///{}", db_path.display()),
+            min_connections: 1,
+            max_connections: 2,
+            run_migrations: true,
+            warmup_connections: 0,
+            ..Default::default()
+        })
+        .expect("create pool");
+        let runtime = asupersync::runtime::RuntimeBuilder::current_thread()
+            .build()
+            .expect("build runtime");
+        let cx = asupersync::Cx::for_testing();
+        runtime
+            .block_on(ensure_project(&cx, &pool, COMMITTED))
+            .into_result()
+            .expect("commit a project");
+
+        let count_sql =
+            |key: &str| format!("SELECT COUNT(*) AS n FROM projects WHERE human_key = '{key}'");
+        let count = |rows: Vec<SqlRow>| rows.first().and_then(|row| row.get_named::<i64>("n").ok());
+
+        // The main file alone (no WAL) must not hold the row yet: nothing
+        // backfilled it, so any reader that sees it read the WAL.
+        let main_only = dir.path().join("main-only.db");
+        std::fs::copy(&db_path, &main_only).expect("copy the main file alone");
+        let backfilled = crate::CanonicalDbConn::open_file(main_only.display().to_string())
+            .expect("open the main file alone");
+        assert_eq!(
+            count(
+                backfilled
+                    .query_sync(&count_sql(COMMITTED), &[])
+                    .expect("query main file")
+            ),
+            Some(0),
+            "the commit was checkpointed into the main file"
+        );
+
+        let writer = crate::DbConn::open_file(db_path.display().to_string())
+            .expect("open uncommitted writer");
