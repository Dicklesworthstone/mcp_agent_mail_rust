+        #[test]
+        fn overflow_watch_loss_and_unknown_descriptors_reject_proof() {
+            let (_temp, _month, mut watch) = fixture();
+            let descriptor = *watch.inner.targets.keys().next().unwrap();
+            for mask in [
+                AddWatchFlags::IN_Q_OVERFLOW,
+                AddWatchFlags::IN_IGNORED,
+                AddWatchFlags::IN_UNMOUNT,
+            ] {
+                assert!(!watch.inner.apply(
+                    InotifyEvent {
+                        wd: descriptor,
+                        mask,
+                        cookie: 0,
+                        name: None,
+                    },
+                    &mut BTreeSet::new(),
+                ));
+            }
+            let removed = watch.inner.targets.remove(&descriptor).unwrap();
+            assert!(!watch.inner.apply(
+                InotifyEvent {
+                    wd: descriptor,
+                    mask: AddWatchFlags::IN_MODIFY,
+                    cookie: 0,
+                    name: Some("history.md".into()),
+                },
+                &mut BTreeSet::new(),
+            ));
+            watch.inner.targets.insert(descriptor, removed);
+            watch.inner.notify.rm_watch(descriptor).unwrap();
+            assert!(watch.drain().is_none(), "real IN_IGNORED must invalidate");
+        }
+
+        #[test]
+        fn unsupported_filesystems_never_authorize_cached_absence() {
+            assert!(supported_filesystem(FsType(0xef53)));
+            assert!(supported_filesystem(FsType(0x0102_1994)));
+            assert!(!supported_filesystem(FsType(0x6969)), "NFS");
+            assert!(
+                !supported_filesystem(nix::sys::statfs::SMB_SUPER_MAGIC),
+                "SMB"
+            );
+            assert!(!supported_filesystem(FsType(0x6573_5546)), "FUSE");
+            assert!(!supported_filesystem(FsType(0x0000_1234)), "unknown");
+        }
+    }
