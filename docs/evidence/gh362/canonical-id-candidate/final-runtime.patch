+fn begin_controlled_fence_append(mailbox: &Mailbox, id: i64) -> std::thread::JoinHandle<()> {
+    let archive = mailbox.archive.clone();
+    let message = mailbox.message(id, "Controlled append while publication is deferred");
+    let path = mailbox.paths(&message).canonical;
+    let content = render_message_bundle_content(&message, "immutable message body").unwrap();
+    let (held_tx, held_rx) = std::sync::mpsc::channel();
+    let (deferred_tx, deferred_rx) = std::sync::mpsc::channel();
+    let controller = std::thread::spawn(move || {
+        let fence = ArchiveMutationGuard::begin_at(&archive.repo_root);
+        held_tx.send(()).unwrap();
+        deferred_rx.recv_timeout(Duration::from_secs(15)).unwrap();
+        // The publisher has released its preparation locks. This is a real
+        // intervening project-lock generation and a new canonical artifact
+        // with synced file bytes, while the controller owns the global fence.
+        with_project_lock(&archive, || {
+            let mut file = fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&path)?;
+            file.write_all(content.as_bytes())?;
+            file.sync_all()?;
+            Ok(())
+        })
+        .unwrap();
+        drop(fence);
+    });
+    held_rx.recv_timeout(Duration::from_secs(15)).unwrap();
+    MESSAGE_PUBLICATION_AFTER_DEFER_TEST_HOOK.with(|slot| {
+        assert!(
+            slot.borrow().is_none(),
+            "a previous deferral hook was not consumed"
+        );
+        *slot.borrow_mut() = Some(Box::new(move || {
+            deferred_tx.send(()).unwrap();
+        }));
+    });
+    controller
+}
