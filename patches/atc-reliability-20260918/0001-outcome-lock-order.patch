+/// Shared external-feedback boundary. Taking the engine first prevents an
+/// outcome worker from holding TUNER while a tick holds ENGINE and needs TUNER.
+fn record_liveness_tuner_outcome(
+    engine_lock: &Mutex<AtcEngine>,
+    tuner_lock: &Mutex<LossMatrixTuner<LivenessAction, LivenessState>>,
+    action: LivenessAction,
+    true_state: LivenessState,
+    regret: f64,
+) {
+    if let Ok(mut engine) = engine_lock.lock() {
+        engine.apply_liveness_tuner_outcome(tuner_lock, action, true_state, regret);
+    }
+}
