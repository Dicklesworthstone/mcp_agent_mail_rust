 /// Whether `wal_frames` WAL frames exceed this connection's
 /// `journal_size_limit`. A negative limit (unbounded WAL) never does.
+/// Whether this connection's `-wal` file is larger than `journal_size_limit`
+/// (never below [`WAL_RESET_MIN_BYTES`]). A missing or unreadable WAL is not.
+fn wal_file_over_journal_size_limit(conn: &crate::DbConn) -> bool {
+    let Ok(metadata) = std::fs::metadata(format!("{}-wal", conn.path())) else {
+        return false;
+    };
+    let Some(limit) = conn
+        .query_sync("PRAGMA journal_size_limit;", &[])
+        .ok()
+        .and_then(|rows| {
+            rows.first()
+                .and_then(|row| row.get(0).and_then(value_as_i64))
+        })
+    else {
+        return false;
+    };
+    limit >= 0 && i64::try_from(metadata.len()).unwrap_or(i64::MAX) > limit.max(WAL_RESET_MIN_BYTES)
+}
