+        pub(super) fn add(&mut self, path: &Path, directory: Option<WatchDirectory>) -> bool {
+            if self.invalidated {
+                return false;
+            }
+            let accepted = self.add_inner(path, directory);
+            self.invalidated |= !accepted;
+            accepted
