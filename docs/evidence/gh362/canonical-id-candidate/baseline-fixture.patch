+    };
+    let archive = ensure_archive(&config, "canonical-history").unwrap();
+    let message = fixture_message(&archive, id, "Completed foreign current-month append");
+    // This is a real public write with its project lock, immutable copies,
+    // commit enqueue, and flush. The process exits before the parent timer.
+    write_message_bundle(
+        &archive,
+        &config,
+        &message,
+        "immutable message body",
+        SENDER,
+        &[RECIPIENT.to_owned()],
