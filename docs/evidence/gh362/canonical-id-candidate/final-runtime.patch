+/// A live conservative control: run the production full identity collector,
+/// then the same preparation, durable no-clobber publication, and coalescer
+/// enqueue used by the public single-message writer. This is explicitly a
+/// full-verification control, not a benchmark of an older release or current
+/// main's former periodic single-writer cache.
+fn publish_with_full_verification(mailbox: &Mailbox, message: &serde_json::Value) -> Result<()> {
+    let recipients = [RECIPIENT.to_owned()];
+    let entry = MessageBundleBatchEntry {
+        message,
+        body_md: "immutable message body",
+        sender: SENDER,
+        recipients: &recipients,
+        extra_paths: &[],
+    };
+    with_prepared_message_publication(
+        &mailbox.archive,
+        || {
+            collect_canonical_message_id_index(
+                &mailbox.archive.root.join("messages"),
+                &batch_message_ids(&[entry]),
+            )
+        },
+        |ids| {
+            let mut paths = Vec::new();
