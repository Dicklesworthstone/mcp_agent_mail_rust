+        let root = tempfile::tempdir().unwrap().keep();
+        let source = root.join("absent.sqlite3");
+        let backup = root.join("published.bak");
+        std::fs::write(&backup, b"previous published generation").unwrap();
+        let error = expect_stage_failure(create_proactive_backup_stage(&source, &backup));
+        let stage = retained_failed_stage(&source, &error);
+        assert!(stage.is_dir());
+        assert!(!source.exists());
+        assert!(!stage.join("snapshot.sqlite3").exists());
+        assert_eq!(std::fs::read(backup).unwrap(), b"previous published generation");
+    }
