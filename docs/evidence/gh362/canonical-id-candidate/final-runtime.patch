+#[test]
+fn canonical_id_external_process_worker() {
+    let Ok(action) = std::env::var(WORKER_ACTION) else {
+        return;
+    };
+    let project = PathBuf::from(std::env::var_os("AM_CANONICAL_ID_WORKER_PROJECT").unwrap());
+    let path = PathBuf::from(std::env::var_os("AM_CANONICAL_ID_WORKER_PATH").unwrap());
+    match action.as_str() {
+        "rewrite" => {
+            let mut lock = FileLock::new(project.join(".archive.lock"));
+            lock.acquire().unwrap();
+            fs::write(path, historical_content(90)).unwrap();
+            lock.release().unwrap();
+        }
+        "cold-duplicate" => {
+            let config = Config {
+                storage_root: PathBuf::from(
+                    std::env::var_os("AM_CANONICAL_ID_WORKER_ROOT").unwrap(),
+                ),
+                ..Config::default()
+            };
+            let archive = ensure_archive(&config, "canonical-history").unwrap();
+            let message = serde_json::json!({
+                "id": 90,
+                "subject": "A new process has no trusted in-memory index",
+                "created": "2026-10-31T12:00:00Z",
+            });
+            let error = write_message_bundle(
+                &archive,
+                &config,
+                &message,
+                "must not publish",
+                SENDER,
+                &[RECIPIENT.to_owned()],
+                &[],
+                None,
+            )
+            .expect_err("a process restart must rebuild identity evidence");
+            assert_collision(&error, 90);
+            assert_eq!(fs::read_to_string(path).unwrap(), historical_content(90));
+        }
+        "crash-after-canonical" | "recover-after-crash" => {
+            let config = Config {
+                storage_root: PathBuf::from(
+                    std::env::var_os("AM_CANONICAL_ID_WORKER_ROOT").unwrap(),
+                ),
+                ..Config::default()
+            };
+            let archive = ensure_archive(&config, "canonical-history").unwrap();
+            let message = fixture_message(&archive, 90, CRASH_PUBLICATION_SUBJECT);
+            let paths =
+                message_paths_for_bundle(&archive, &message, SENDER, &[RECIPIENT.to_owned()])
+                    .unwrap()
+                    .0;
+            assert_eq!(paths.canonical, path);
+            let expected =
+                render_message_bundle_content(&message, "immutable message body").unwrap();
+            assert!(!paths.outbox.exists());
+            assert!(paths.inbox.iter().all(|target| !target.exists()));
+            if action == "crash-after-canonical" {
+                assert!(!paths.canonical.exists());
+                let installed_paths = paths.clone();
+                MESSAGE_PUBLICATION_AFTER_FIRST_INSTALL_TEST_HOOK.with(|slot| {
+                    *slot.borrow_mut() = Some(Box::new(move || {
+                        assert_eq!(
+                            fs::read_to_string(&installed_paths.canonical).unwrap(),
+                            expected
+                        );
+                        assert!(!installed_paths.outbox.exists());
+                        assert!(installed_paths.inbox.iter().all(|target| !target.exists()));
+                        // Exit without running Rust guard, staged-temp, or
+                        // cache destructors, while real publication is held
+                        // between the canonical and remaining copy installs.
+                        std::process::exit(77);
+                    }));
+                });
+                write_message_bundle(
+                    &archive,
+                    &config,
+                    &message,
+                    "immutable message body",
+                    SENDER,
+                    &[RECIPIENT.to_owned()],
+                    &[],
+                    None,
+                )
+                .unwrap();
+                panic!("the crash worker returned instead of exiting after canonical installation");
+            }
+            assert_eq!(fs::read_to_string(&paths.canonical).unwrap(), expected);
+            let canonical_stamp = current_path_stamp(&paths.canonical);
+            reset_canonical_id_check_fs_counts();
+            write_message_bundle(
+                &archive,
+                &config,
+                &message,
+                "immutable message body",
+                SENDER,
+                &[RECIPIENT.to_owned()],
+                &[],
+                None,
+            )
+            .unwrap();
+            assert!(
+                canonical_id_check_fs_counts().0 > 0,
+                "a fresh recovering process must inventory canonical evidence"
+            );
+            assert_eq!(current_path_stamp(&paths.canonical), canonical_stamp);
+            for target in [&paths.canonical, &paths.outbox]
+                .into_iter()
+                .chain(&paths.inbox)
+            {
+                assert_eq!(fs::read_to_string(target).unwrap(), expected);
+            }
+            let conflict = fixture_message(&archive, 90, "A conflicting recovered identity");
+            let conflict_paths =
+                message_paths_for_bundle(&archive, &conflict, SENDER, &[RECIPIENT.to_owned()])
+                    .unwrap()
+                    .0;
+            assert_collision(
+                &write_message_bundle(
+                    &archive,
+                    &config,
+                    &conflict,
+                    "must not replace interrupted evidence",
+                    SENDER,
+                    &[RECIPIENT.to_owned()],
+                    &[],
+                    None,
+                )
+                .expect_err("recovery must retain the original canonical identity"),
+                90,
+            );
+            for target in [&conflict_paths.canonical, &conflict_paths.outbox]
+                .into_iter()
+                .chain(&conflict_paths.inbox)
+            {
+                assert!(
+                    !target.exists(),
+                    "conflicting recovery published {}",
+                    target.display()
+                );
+            }
+            assert_eq!(fs::read_to_string(&paths.canonical).unwrap(), expected);
+            assert_eq!(current_path_stamp(&paths.canonical), canonical_stamp);
+            flush_fixture_commits();
+        }
+        _ => panic!("unknown worker action {action}"),
+    }
+}
