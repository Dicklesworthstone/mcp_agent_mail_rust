+
+        fn fixture() -> (TempDir, PathBuf, CanonicalWatch) {
+            let temp = TempDir::new().unwrap();
+            let messages = temp.path().join("messages");
+            let year = messages.join("2025");
+            let month = year.join("01");
+            fs::create_dir_all(&month).unwrap();
+            let mut watch = CanonicalWatch::new(temp.path())
+                .expect("tests require a supported local filesystem and inotify");
+            assert!(watch.watch_directory(&messages, WatchDirectory::Messages));
+            assert!(watch.watch_directory(&year, WatchDirectory::Year));
+            assert!(watch.watch_directory(&month, WatchDirectory::Month));
+            assert_eq!(watch.drain(), Some(BTreeSet::new()));
+            (temp, month, watch)
+        }
+
+        #[test]
+        fn completed_in_place_write_is_observed_without_parent_timestamp_change() {
+            let (_temp, month, mut watch) = fixture();
+            let file = month.join("history.md");
+            fs::write(&file, b"old identity").unwrap();
+            assert!(watch.watch_file(&file));
+            let _ = watch.drain().unwrap();
+            let before = fs::metadata(&month).unwrap();
+            fs::write(&file, b"new identity").unwrap();
+            let after = fs::metadata(&month).unwrap();
+            assert_eq!(before.mtime_nsec(), after.mtime_nsec());
+            assert_eq!(before.ctime_nsec(), after.ctime_nsec());
+            assert_eq!(watch.drain(), Some(BTreeSet::from([file])));
+            assert_eq!(watch.drain(), Some(BTreeSet::new()));
+        }
+
+        #[test]
+        fn inode_watch_covers_alias_created_after_bootstrap_and_open_writer() {
+            let (temp, month, mut watch) = fixture();
+            let file = month.join("history.md");
+            fs::write(&file, b"old identity").unwrap();
+            assert!(watch.watch_file(&file));
+            let _ = watch.drain().unwrap();
+            let alias = temp.path().join("outbox.md");
+            fs::hard_link(&file, &alias).unwrap();
+            let _ = watch.drain().unwrap();
+
+            let mut writer = fs::OpenOptions::new().write(true).open(&alias).unwrap();
+            writer.write_all(b"new identity").unwrap();
+            // MODIFY must be sufficient: waiting for CLOSE_WRITE would miss a
+            // writer that retains its handle until after the next publication.
+            assert_eq!(watch.drain(), Some(BTreeSet::from([file.clone()])));
+            drop(writer);
+            assert_eq!(watch.drain(), Some(BTreeSet::from([file])));
+        }
+
+        #[test]
+        fn namespace_changes_invalidate_but_unrelated_project_writes_do_not() {
+            let (temp, month, mut watch) = fixture();
+            fs::write(temp.path().join(".archive.lock.owner.json"), b"owner").unwrap();
+            fs::create_dir(temp.path().join("agents")).unwrap();
+            assert_eq!(watch.drain(), Some(BTreeSet::new()));
+            fs::rename(&month, month.with_file_name("02")).unwrap();
+            assert!(watch.drain().is_none());
+            assert!(watch.drain().is_none(), "invalidation must be sticky");
+        }
+
+        #[test]
+        fn enrollment_refuses_symlinks_and_multiple_paths_for_one_inode() {
+            let (temp, month, mut watch) = fixture();
+            let file = month.join("history.md");
+            fs::write(&file, b"identity").unwrap();
+            assert!(watch.watch_file(&file));
+            assert!(
+                watch.watch_file(&file),
+                "same-path enrollment is idempotent"
+            );
+            let alias = month.join("alias.md");
+            fs::hard_link(&file, &alias).unwrap();
+            assert!(!watch.watch_file(&alias));
+            assert!(watch.drain().is_none());
+
+            let mut watch = CanonicalWatch::new(temp.path()).unwrap();
+            let link = temp.path().join("linked-month");
+            symlink(&month, &link).unwrap();
+            assert!(!watch.watch_directory(&link, WatchDirectory::Month));
+            assert!(watch.drain().is_none());
+        }
+
+        #[test]
+        fn replacement_inode_cannot_reuse_the_previous_path_witness() {
+            let (_temp, month, mut watch) = fixture();
