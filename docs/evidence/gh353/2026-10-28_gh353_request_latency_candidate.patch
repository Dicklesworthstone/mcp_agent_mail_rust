+                        &pool,
+                        project_id,
+                        sender.id.unwrap(),
+                        &[(recipient.id.unwrap(), "to")],
+                    )
+                    .await;
+                    let leases = queries::create_file_reservations(
+                        &cx,
+                        &pool,
+                        project_id,
+                        sender.id.unwrap(),
+                        &["src/owned.rs"],
