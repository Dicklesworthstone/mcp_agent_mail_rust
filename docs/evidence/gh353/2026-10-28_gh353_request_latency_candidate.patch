+            assert_eq!(completed, vec![Err(McpError::request_cancelled().code); 10]);
+            assert!(completion_latency < Duration::from_secs(2));
+            assert!(retained_owner);
+            assert_eq!(counted, 0);
+            assert!(all_tokens_cancelled);
+            assert_eq!(
+                request_cx.is_cancel_requested(),
