+/// A public-writer-only worker for comparing two actual source revisions in
+/// one orchestrated run. Copy this test and its fixture helpers unchanged into
+/// the baseline test build; only test-only counters are needed there. Unlike
+/// the live conservative control below, this worker never selects a verifier.
+#[test]
+#[ignore = "paired revision benchmark worker; set AM_CANONICAL_BENCH_MESSAGES and run explicitly"]
+fn canonical_publication_public_writer_benchmark() {
+    if !isolated_case_inner("canonical_publication_public_writer_benchmark", true) {
+        return;
+    }
+    let count: usize = std::env::var("AM_CANONICAL_BENCH_MESSAGES")
+        .expect("set AM_CANONICAL_BENCH_MESSAGES to 5000, 50000, or 150000")
+        .parse()
+        .expect("parse benchmark history count");
+    assert!([5_000, 50_000, 150_000].contains(&count));
+    let rounds: i64 = std::env::var("AM_CANONICAL_BENCH_ROUNDS")
+        .unwrap_or_else(|_| "8".to_owned())
+        .parse()
+        .expect("parse benchmark sample count");
+    assert!((1..=1_000).contains(&rounds));
+    let requested_scenario =
+        std::env::var("AM_CANONICAL_BENCH_SCENARIO").unwrap_or_else(|_| "all".to_owned());
+    let scenarios: &[&str] = match requested_scenario.as_str() {
+        "all" => &[
+            "warm_single_writer",
+            "foreign_append",
+            "controlled_fence_deferral",
+        ],
+        "warm_single_writer" => &["warm_single_writer"],
+        "foreign_append" => &["foreign_append"],
+        "controlled_fence_deferral" => &["controlled_fence_deferral"],
+        other => panic!("unknown benchmark scenario {other}"),
+    };
+    let mailbox = Mailbox::new();
+    let seeded = Instant::now();
+    seed_scale_mailbox(&mailbox, count);
+    let seeded_tree_oid = Repository::open(&mailbox.archive.repo_root)
+        .unwrap()
+        .head()
+        .unwrap()
+        .peel_to_tree()
+        .unwrap()
+        .id()
+        .to_string();
+    let base_id = i64::try_from(count).unwrap() + 100;
+    let cold = Instant::now();
+    mailbox
+        .publish(&mailbox.message(base_id, "Cold canonical verification"))
+        .unwrap();
+    let cold_us = cold.elapsed().as_micros();
+    flush_fixture_commits();
+    mailbox
+        .publish(&mailbox.message(base_id + 1, "Settle own publication events"))
+        .unwrap();
+    flush_fixture_commits();
+    println!(
+        "{}",
+        serde_json::json!({
+            "kind": "canonical_publication_public_setup",
+            "history_messages": count,
+            "historical_tracked_copies": count * 3,
+            "seeded_git_tree_oid": seeded_tree_oid,
+            "historical_mailbox_copies": "hardlinked fixture; measured new copies are independent",
+            "setup_ms": seeded.elapsed().as_millis(),
+            "cold_publication_us": cold_us,
+            "rounds": rounds,
+            "scenarios": scenarios,
+            "watch_supported_and_enrolled": benchmark_watch_enrollment(&mailbox),
+        })
+    );
+    let mut next_id = base_id + 2;
+    for &scenario in scenarios {
+        for round in 0..rounds {
+            let controller = match scenario {
+                "foreign_append" => {
+                    append_foreign_benchmark_message(&mailbox, next_id);
+                    next_id += 1;
+                    None
+                }
+                "controlled_fence_deferral" => {
+                    let controller = begin_controlled_fence_append(&mailbox, next_id);
+                    next_id += 1;
+                    Some(controller)
+                }
+                _ => None,
+            };
+            let message = mailbox.message(
+                next_id,
+                &format!("Measured public-writer publication {round}"),
+            );
+            next_id += 1;
+            reset_canonical_id_check_fs_counts();
+            CANONICAL_PUBLICATION_FENCE_HELD.with(|held| held.set(Duration::ZERO));
+            CANONICAL_PROJECT_LOCK_HELD.with(|held| held.set(Duration::ZERO));
+            let started = Instant::now();
+            let publication = mailbox.publish(&message);
+            let publication_us = started.elapsed().as_micros();
+            let (read_dirs, metadata_calls) = canonical_id_check_fs_counts();
+            let fence_us = CANONICAL_PUBLICATION_FENCE_HELD
+                .with(std::cell::Cell::get)
+                .as_micros();
+            let project_lock_us = CANONICAL_PROJECT_LOCK_HELD
+                .with(std::cell::Cell::get)
+                .as_micros();
+            if let Some(controller) = controller {
+                controller.join().expect("controlled publication scheduler");
+            }
+            publication.unwrap();
+            let flush_started = Instant::now();
+            flush_async_commits();
+            let commit_flush_us = flush_started.elapsed().as_micros();
+            assert_fixture_coalescer_idle();
+            println!(
+                "{}",
+                serde_json::json!({
+                    "kind": "canonical_publication_public_sample",
+                    "history_messages": count,
+                    "round": round,
+                    "scenario": scenario,
+                    "watch_supported_and_enrolled": benchmark_watch_enrollment(&mailbox),
+                    "publication_us": publication_us,
+                    "canonical_read_dirs": read_dirs,
+                    "canonical_metadata_calls": metadata_calls,
+                    "publication_thread_fence_held_us": fence_us,
+                    "publication_thread_project_lock_held_us": project_lock_us,
+                    "async_commit_flush_us": commit_flush_us,
+                })
+            );
+        }
+    }
+    CANONICAL_ID_CACHES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .remove(&mailbox.archive.root.join("messages"));
+}
