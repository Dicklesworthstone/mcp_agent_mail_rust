+                    .expect("warm pool remains available")
+                    .engine_identity_key(),
+                engine,
+            );
+            for log in [
+                "acknowledge_message.jsonl",
+                "release_file_reservations.jsonl",
+            ] {
+                assert!(
+                    !mailbox
+                        .storage_root
+                        .join("degraded_intents")
+                        .join(log)
+                        .exists(),
+                    "cancelled requests must not schedule future mutations",
