+//! Synchronous change evidence for the canonical message identity cache.
+//!
+//! A directory timestamp cannot witness edits to an existing child. On local
+//! Linux filesystems, a private inotify queue instead covers every canonical
+//! directory AND every canonical inode. The inode watches matter: a write
+//! through an outbox hard link, or a hard link created after bootstrap, need not
+//! notify the canonical parent directory.
+//!
+//! Enroll directories before enumerating them and files before reading their
+//! identity, then drain after the inspection. A missing watch, namespace
+//! replacement, queue overflow, unknown descriptor, or bounded-drain exhaustion
+//! invalidates the entire witness. Never clear an invalid witness; rebuild it
+//! together with a full inventory. No worker thread or delivery delay lies
+//! between a completed filesystem operation and the publication check.
+//!
+//! This witnesses ordinary local filesystem writes, not hostile same-user
+//! activity. Linux does not report stores through writable mmap mappings, and
+//! advisory archive locks do not exclude an uncooperative writer racing the
+//! final publication. Remote and unknown filesystem types therefore do not use
+//! this fast path; the caller retains its conservative verification path.
+
+use std::collections::BTreeSet;
+use std::path::{Path, PathBuf};
+
+/// Which canonical namespace a watched directory contains.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum WatchDirectory {
+    Project,
+    Messages,
+    Year,
+    Month,
+}
+
+/// A change witness owned and drained under the canonical cache's mutex.
+#[derive(Debug)]
+pub struct CanonicalWatch {
+    #[cfg(target_os = "linux")]
+    inner: linux::Watch,
+}
+
+impl CanonicalWatch {
+    /// Start witnessing an existing project. Unsupported filesystems/platforms
+    /// and resource exhaustion disable the optimization, never verification.
+    pub(super) fn new(project_root: &Path) -> Option<Self> {
+        #[cfg(target_os = "linux")]
+        {
+            let mut watch = Self {
+                inner: linux::Watch::new(project_root)?,
+            };
+            watch
+                .watch_directory(project_root, WatchDirectory::Project)
+                .then_some(watch)
+        }
+        #[cfg(not(target_os = "linux"))]
+        {
+            let _ = project_root;
+            None
+        }
+    }
+
+    /// Must be called before enumerating this directory. Failure invalidates
+    /// the whole witness, including the previously enrolled directories.
+    pub(super) fn watch_directory(&mut self, path: &Path, kind: WatchDirectory) -> bool {
+        #[cfg(target_os = "linux")]
+        {
+            self.inner.add(path, Some(kind))
+        }
+        #[cfg(not(target_os = "linux"))]
+        {
+            let _ = (path, kind);
+            false
+        }
+    }
+
+    /// Must be called before inspecting a canonical file, including new files
+    /// published by this process. Files are watched even with link count one:
+    /// another link could be created after this call.
+    pub(super) fn watch_file(&mut self, path: &Path) -> bool {
+        #[cfg(target_os = "linux")]
+        {
+            self.inner.add(path, None)
+        }
+        #[cfg(not(target_os = "linux"))]
+        {
+            let _ = path;
+            false
+        }
+    }
+
+    /// Return changed canonical paths after draining to EAGAIN. A named path
+    /// may now be missing or replaced, so the caller must inspect it again.
+    /// `None` means this witness is permanently invalid and requires a rebuild.
+    pub(super) fn drain(&mut self) -> Option<BTreeSet<PathBuf>> {
+        #[cfg(target_os = "linux")]
+        {
+            self.inner.drain()
+        }
+        #[cfg(not(target_os = "linux"))]
+        {
+            None
+        }
+    }
+}
+
