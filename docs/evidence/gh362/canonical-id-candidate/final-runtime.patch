+#[test]
+fn exhausted_optimistic_attempts_make_progress_with_fresh_synchronized_identity_checks() {
+    if !isolated_case(
+        "exhausted_optimistic_attempts_make_progress_with_fresh_synchronized_identity_checks",
+    ) {
+        return;
+    }
+    for variant in [
+        "generation-only",
+        "new-canonical-files",
+        "last-writer-conflict",
+    ] {
+        let mailbox = Mailbox::new();
+        let historical = mailbox.seed_old_history();
+        assert!(
+            canonical_id_cache_for(&mailbox.archive.root.join("messages"))
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .watch
+                .is_some(),
+            "retry-budget regression requires a complete local change witness"
+        );
+        let outgoing = mailbox.message(90, "Progress after four cooperating intervening writers");
+        let (commands_tx, commands_rx) = std::sync::mpsc::channel();
+        let (responses_tx, responses_rx) = std::sync::mpsc::channel();
+        let archive = mailbox.archive.clone();
+        let controller = std::thread::spawn(move || {
+            let mut retained = Vec::new();
+            for round in 0..4 {
+                assert_eq!(
+                    commands_rx.recv_timeout(Duration::from_secs(15)).unwrap(),
+                    RetryBudgetSignal::Prepared(round)
+                );
+                let fence = ArchiveMutationGuard::begin_at(&archive.repo_root);
+                responses_tx
+                    .send(RetryBudgetSignal::FenceHeld(round))
+                    .unwrap();
+                assert_eq!(
+                    commands_rx.recv_timeout(Duration::from_secs(15)).unwrap(),
+                    RetryBudgetSignal::Deferred(round)
+                );
+                with_project_lock(&archive, || {
+                    if variant != "generation-only" {
+                        let id = if variant == "last-writer-conflict" && round == 3 {
+                            90
+                        } else {
+                            1_000 + i64::try_from(round).unwrap()
+                        };
+                        let path = archive
+                            .root
+                            .join("messages/2026/10")
+                            .join(format!("retry-controller__{id}.md"));
+                        let content = historical_content(id);
+                        let mut file = fs::OpenOptions::new()
+                            .write(true)
+                            .create_new(true)
+                            .open(&path)?;
+                        file.write_all(content.as_bytes())?;
+                        file.sync_all()?;
+                        retained.push((path, content));
+                    }
+                    Ok(())
+                })
+                .unwrap();
+                drop(fence);
+                responses_tx
+                    .send(RetryBudgetSignal::Released(round))
+                    .unwrap();
+            }
+            retained
+        });
+        let fallback_seen = Arc::new(AtomicBool::new(false));
+        let deferrals = Arc::new(AtomicUsize::new(0));
+        arm_retry_budget_hooks(
+            0,
+            commands_tx,
+            Arc::new(Mutex::new(responses_rx)),
+            archive_project_root_checked(&mailbox.archive).unwrap(),
+            Arc::clone(&fallback_seen),
+            Arc::clone(&deferrals),
+        );
+        let result = mailbox.publish(&outgoing);
+        let controlled = controller.join();
+        assert!(
+            controlled.is_ok(),
+            "{variant}: retry controller failed; publication returned {result:?}"
+        );
+        assert_eq!(deferrals.load(Ordering::Acquire), 4, "{variant}");
+        if variant == "last-writer-conflict" {
+            assert_collision(
+                &result.expect_err("final proof must observe the winning ID"),
+                90,
+            );
+            mailbox.assert_unpublished(&outgoing);
+        } else {
+            result.unwrap();
+            assert!(fallback_seen.load(Ordering::Acquire), "{variant}");
+            let expected =
+                render_message_bundle_content(&outgoing, "immutable message body").unwrap();
+            let paths = mailbox.paths(&outgoing);
+            for path in [&paths.canonical, &paths.outbox]
+                .into_iter()
+                .chain(&paths.inbox)
+            {
+                assert_eq!(fs::read_to_string(path).unwrap(), expected, "{variant}");
+            }
+        }
+        for (path, content) in controlled.unwrap() {
+            assert_eq!(fs::read_to_string(path).unwrap(), content, "{variant}");
+        }
+        assert_eq!(
+            fs::read_to_string(historical).unwrap(),
+            historical_content(10)
+        );
+        flush_fixture_commits();
+    }
+}
