+    #[test]
+    fn real_staging_normalizes_an_export_defect_before_capturing_a_publish_witness() {
+        let (source, conn) = fixture("idx_order", &["Z", "["], "NOCASE", "NOCASE", false);
+        let expected_rows = agent_rows(&conn);
+        let expected_ddl = conn.query_sync("SELECT sql FROM sqlite_master WHERE name='idx_order'", &[])
+            .unwrap()[0].get_named::<String>("sql").unwrap();
+        drop(conn);
+        let before = std::fs::read(&source).unwrap();
+        let backup = source.with_file_name("published.bak");
+        std::fs::write(&backup, b"previous published generation").unwrap();
+        let (directory, snapshot) = create_proactive_backup_stage_with(
+            &source, &backup, |export| {
+                // Reproduce the exporter's wrong physical key order ONLY in
+                // the just-created private file; leave its final DDL identical.
+                let private = crate::CanonicalDbConn::open_file(export.to_str().unwrap())
+                    .map_err(|error| DbError::Sqlite(error.to_string()))?;
+                private.execute_raw(
+                    "DROP INDEX idx_order; \
+                     CREATE UNIQUE INDEX \"idx_order\" ON agents(project_id, name COLLATE BINARY); \
+                     PRAGMA writable_schema=ON; \
+                     UPDATE sqlite_master SET sql=replace(sql, 'COLLATE BINARY', 'COLLATE NOCASE') \
+                         WHERE name='idx_order'; \
+                     PRAGMA writable_schema=OFF; PRAGMA schema_version=202;"
+                ).map_err(|error| DbError::Sqlite(error.to_string()))?;
+                assert!(!integrity::details_indicate_ok(&full(&private)));
+                Ok(())
+            },
+        ).unwrap();
+        let retained = directory.preserve();
+        assert!(snapshot.starts_with(retained));
+        // Exercise the production capture -> strict validation -> identity
+        // verification ordering. No normalizer runs after witness capture.
+        let witness = ProactiveBackupWitness::capture(&snapshot).unwrap();
+        validate_proactive_backup_stage(&source, &snapshot).unwrap();
+        witness.verify(&snapshot).unwrap();
+        let canonical = open_immutable_canonical_sqlite(&snapshot).unwrap();
+        assert_eq!(agent_rows(&canonical), expected_rows);
+        assert_eq!(canonical.query_sync("SELECT sql FROM sqlite_master WHERE name='idx_order'", &[])
+            .unwrap()[0].get_named::<String>("sql").unwrap(), expected_ddl);
+        assert_eq!(std::fs::read(source).unwrap(), before);
+        assert_eq!(std::fs::read(backup).unwrap(), b"previous published generation");
+    }
