+    fn fixture(
+        index: &str,
+        names: &[&str],
+        original_collation: &str,
+        declared_collation: &str,
+        partial: bool,
+    ) -> (PathBuf, crate::CanonicalDbConn) {
+        let root = tempfile::tempdir().expect("private retained fixture").keep();
+        let path = root.join("live-export.sqlite3");
+        let conn = crate::CanonicalDbConn::open_file(path.to_str().unwrap()).unwrap();
+        conn.execute_raw("PRAGMA journal_mode=DELETE").unwrap();
+        conn.execute_raw(SCHEMA).unwrap();
+        let quoted = index.replace('"', "\"\"");
+        let predicate = if partial { " WHERE name IS NOT NULL" } else { "" };
+        conn.execute_raw(&format!(
+            "CREATE UNIQUE INDEX \"{quoted}\" ON agents(project_id, name COLLATE \
+             {original_collation}){predicate}"
+        ))
+        .unwrap();
+        for (offset, name) in names.iter().enumerate() {
+            let id = offset + 1;
+            let escaped = name.replace('\'', "''");
+            conn.execute_raw(&format!("INSERT INTO agents VALUES ({id}, 1, '{escaped}')"))
+                .unwrap();
+        }
+        if original_collation != declared_collation {
+            // Change ONLY this private fixture's declaration, leaving the
+            // original real index pages in the old collation's order.
+            let literal = index.replace('\'', "''");
+            conn.execute_raw(&format!(
+                "PRAGMA writable_schema=ON; \
+                 UPDATE sqlite_master SET sql=replace(sql, 'COLLATE {original_collation}', \
+                 'COLLATE {declared_collation}') WHERE name='{literal}'; \
+                 PRAGMA writable_schema=OFF; PRAGMA schema_version=101;"
+            ))
+            .unwrap();
+        }
+        (path, conn)
+    }
+
+    fn full(conn: &crate::CanonicalDbConn) -> Vec<String> {
+        proactive_backup_export_check_details(conn, integrity::CheckKind::Full).unwrap()
+    }
+
+    fn agent_rows(conn: &crate::CanonicalDbConn) -> Vec<(i64, i64, Option<String>)> {
+        conn.query_sync("SELECT id, project_id, name FROM agents NOT INDEXED ORDER BY id", &[])
+            .unwrap()
+            .iter()
+            .map(|row| {
+                let name = match row.get_by_name("name") {
+                    Some(Value::Text(name)) => Some(name.clone()),
+                    Some(Value::Null) => None,
+                    value => panic!("unexpected fixture name: {value:?}"),
+                };
+                (row.get_named("id").unwrap(), row.get_named("project_id").unwrap(), name)
+            })
+            .collect()
+    }
