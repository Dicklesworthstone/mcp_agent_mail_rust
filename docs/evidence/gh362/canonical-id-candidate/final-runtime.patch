+fn concurrent_sends_preserve_unique_ids_and_elect_one_conflicting_identity() {
+    if !isolated_case("concurrent_sends_preserve_unique_ids_and_elect_one_conflicting_identity") {
+        return;
+    }
+    let mailbox = Mailbox::new();
+    mailbox.seed_old_history();
+    for conflict in [false, true] {
+        let barrier = std::sync::Barrier::new(8);
+        let results = std::thread::scope(|scope| {
+            let workers: Vec<_> = (0..8)
+                .map(|i| {
+                    let barrier = &barrier;
+                    let mailbox = &mailbox;
+                    scope.spawn(move || {
+                        let id = if conflict { 200 } else { 100 + i };
+                        let message = mailbox.message(id, &format!("Concurrent writer {i}"));
+                        barrier.wait();
+                        mailbox.publish(&message)
+                    })
+                })
+                .collect();
+            workers
+                .into_iter()
+                .map(|worker| worker.join().unwrap())
+                .collect::<Vec<_>>()
+        });
+        assert_eq!(
+            results.iter().filter(|result| result.is_ok()).count(),
+            if conflict { 1 } else { 8 }
+        );
+        if conflict {
+            for error in results.into_iter().filter_map(std::result::Result::err) {
+                assert_collision(&error, 200);
+            }
+        }
+    }
+    let files = list_message_files(&mailbox.archive.root.join("messages")).unwrap();
+    let mut counts = HashMap::new();
+    for path in files {
+        let (message, _) = read_message_file(&path).unwrap();
+        *counts.entry(message["id"].as_i64().unwrap()).or_insert(0) += 1;
+    }
+    for id in (100..108).chain(std::iter::once(200)) {
+        assert_eq!(counts.get(&id), Some(&1), "identity {id} was not unique");
+    }
+    flush_fixture_commits();
+}
