+#[test]
+fn canonical_publication_foreign_sender() {
+    let Some(root) = std::env::var_os("AM_CANONICAL_BENCH_FOREIGN_ROOT") else {
+        return;
+    };
+    let id = std::env::var("AM_CANONICAL_BENCH_FOREIGN_ID")
+        .unwrap()
+        .parse()
