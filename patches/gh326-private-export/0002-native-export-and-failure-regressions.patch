+    fn expect_stage_failure(
+        result: DbResult<(CanonicalSnapshotTempDir, PathBuf)>,
+    ) -> DbError {
+        match result {
+            Err(error) => error,
+            Ok((directory, snapshot)) => {
+                let retained = directory.preserve();
+                panic!("unexpected successful snapshot {snapshot:?}; stage retained at {retained:?}");
+            }
+        }
+    }
+
+    fn retained_failed_stage(primary: &Path, error: &DbError) -> PathBuf {
+        let stages = std::fs::read_dir(primary.parent().unwrap())
+            .unwrap()
+            .map(Result::unwrap)
+            .filter(|entry| {
+                entry.file_type().unwrap().is_dir()
+                    && entry.file_name().to_string_lossy()
+                        .starts_with(".mcp-agent-mail-proactive-backup-")
+            })
+            .map(|entry| entry.path())
+            .collect::<Vec<_>>();
+        assert_eq!(stages.len(), 1, "failed attempt must retain its exact private stage: {error}");
+        assert!(error.to_string().contains(&stages[0].display().to_string()));
+        stages[0].clone()
+    }
